<UserControl x:Class="InputTracker.DateRangePicker"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppTextFontFamily}"
             Foreground="{DynamicResource PrimaryTextBrush}">
    <UserControl.Resources>
        <DropShadowEffect x:Key="PickerShadow" BlurRadius="28" ShadowDepth="8"
                          Direction="270" Color="#FF0B1020" Opacity="0.2" />

        <Style x:Key="PickerButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontFamily" Value="{DynamicResource AppTextFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DayButtonStyle" TargetType="Button" BasedOn="{StaticResource PickerButtonStyle}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontWeight" Value="Normal" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsInRange}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEndpoint}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsInDisplayMonth}" Value="False">
                    <Setter Property="Opacity" Value="0.38" />
                </DataTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.22" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DateCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="{DynamicResource SubtleBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Button x:Name="OpenRangeButton" Height="38" MinWidth="246" Padding="13,0"
                Style="{StaticResource PickerButtonStyle}" Click="OpenRangeButton_Click">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="16" Height="16" VerticalAlignment="Center">
                    <Border Margin="1,3,1,1" BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1.5" CornerRadius="2" />
                    <Line X1="4" Y1="1" X2="4" Y2="5" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" />
                    <Line X1="12" Y1="1" X2="12" Y2="5" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" />
                    <Line X1="2" Y1="7" X2="14" Y2="7" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.2" />
                </Grid>
                <TextBlock x:Name="RangeText" Grid.Column="2" VerticalAlignment="Center"
                           FontSize="13" FontWeight="SemiBold" />
                <Path Grid.Column="4" Width="8" Height="5" VerticalAlignment="Center"
                      Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource SecondaryTextBrush}"
                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Grid>
        </Button>

        <Popup x:Name="PickerPopup" PlacementTarget="{Binding ElementName=OpenRangeButton}"
               Placement="Bottom" VerticalOffset="7"
               AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
            <Border Width="570" Padding="18" Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="16" Effect="{StaticResource PickerShadow}">
                <StackPanel>
                    <TextBlock Text="选择日期范围" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,14" Text="首尾两天都会计入统计，只按日期筛选。"
                               FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />

                    <WrapPanel Margin="0,0,0,16">
                        <Button x:Name="TodayPresetButton" Width="64" Margin="0,0,6,0"
                                Style="{StaticResource PickerButtonStyle}" Tag="1"
                                Click="PresetButton_Click" Content="今天" />
                        <Button x:Name="SevenDayPresetButton" Width="64" Margin="0,0,6,0"
                                Style="{StaticResource PickerButtonStyle}" Tag="7"
                                Click="PresetButton_Click" Content="7 天" />
                        <Button x:Name="FourteenDayPresetButton" Width="68" Margin="0,0,6,0"
                                Style="{StaticResource PickerButtonStyle}" Tag="14"
                                Click="PresetButton_Click" Content="14 天" />
                        <Button x:Name="ThirtyDayPresetButton" Width="68"
                                Style="{StaticResource PickerButtonStyle}" Tag="30"
                                Click="PresetButton_Click" Content="30 天" />
                    </WrapPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Border Style="{StaticResource DateCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="开始日期" FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock x:Name="StartDateText" Margin="0,5,0,0"
                                               FontSize="16" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Margin="0,8,0,0" Style="{StaticResource DateCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="结束日期" FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock x:Name="EndDateText" Margin="0,5,0,0"
                                               FontSize="16" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="SelectionHintText" Margin="2,12,2,0"
                                       Text="点一下选择开始，再点一下选择结束。"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="38" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource PickerButtonStyle}" Padding="0"
                                        Click="PreviousMonthButton_Click" Content="‹" FontSize="20" />
                                <TextBlock x:Name="MonthTitleText" Grid.Column="1"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="15" FontWeight="SemiBold" />
                                <Button x:Name="NextMonthButton" Grid.Column="2"
                                        Style="{StaticResource PickerButtonStyle}" Padding="0"
                                        Click="NextMonthButton_Click" Content="›" FontSize="20" />
                            </Grid>
                            <UniformGrid Columns="7" Margin="0,0,0,4">
                                <TextBlock Text="日" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Text="一" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Text="二" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Text="三" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Text="四" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Text="五" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Text="六" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
                            </UniformGrid>
                            <ItemsControl x:Name="DayItems">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="7" Rows="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource DayButtonStyle}"
                                                Content="{Binding DayNumber}"
                                                IsEnabled="{Binding IsEnabled}"
                                                Click="DayButton_Click" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Margin="0,16,0,14" Background="{DynamicResource BorderBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Width="82" Margin="0,0,8,0" Style="{StaticResource PickerButtonStyle}"
                                Click="CancelButton_Click" Content="取消" />
                        <Button Width="96" Style="{StaticResource PickerButtonStyle}"
                                Foreground="{DynamicResource AccentTextBrush}"
                                Background="{DynamicResource AccentBrush}"
                                BorderBrush="{DynamicResource AccentBrush}"
                                Click="ConfirmButton_Click" Content="确定" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
