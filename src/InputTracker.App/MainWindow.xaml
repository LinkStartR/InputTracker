<Window x:Class="InputTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="InputTracker"
        Width="1280" Height="800" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{DynamicResource AppTextFontFamily}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">
    <Window.Resources>
        <DropShadowEffect x:Key="CardShadowEffect"
                          BlurRadius="18"
                          ShadowDepth="3"
                          Direction="270"
                          Color="#FF172033"
                          Opacity="0.08" />

        <DrawingBrush x:Key="MouseGridBrush"
                      TileMode="Tile"
                      Viewport="0,0,32,32"
                      ViewportUnits="Absolute"
                      Stretch="None">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="Transparent">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{DynamicResource BorderBrush}" Thickness="0.65" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="0,0" EndPoint="32,0" />
                            <LineGeometry StartPoint="0,0" EndPoint="0,32" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="ButtonChrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.42" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style x:Key="SoftButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBrush}" />
        </Style>

        <Style x:Key="QuietButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Foreground="{DynamicResource PrimaryTextBrush}"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboChrome"
                                                Background="{DynamicResource CardBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="34" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Margin="11,0,4,0"
                                                                  VerticalAlignment="Center"
                                                                   Content="{TemplateBinding Content}"
                                                                   ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                   ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                                   TextElement.Foreground="{TemplateBinding Foreground}" />
                                                <Path Grid.Column="1"
                                                      Width="8" Height="5"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="M 0 0 L 4 4 L 8 0"
                                                      Stroke="{DynamicResource SecondaryTextBrush}"
                                                      StrokeThickness="1.5"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ComboChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="320"
                                        Margin="0,4,0,0"
                                        Padding="4"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9">
                                    <ScrollViewer CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="DropDownToggle" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemChrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Padding" Value="20" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect" Value="{StaticResource CardShadowEffect}" />
        </Style>

        <Style x:Key="CompactCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="14" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Effect" Value="{x:Null}" />
        </Style>

        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppTextFontFamily}" />
            <Setter Property="FontSize" Value="27" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>

        <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        </Style>

        <Style x:Key="NavigationTabItemStyle" TargetType="TabItem">
            <Setter Property="Width" Value="172" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="NavigationChrome"
                                Background="Transparent"
                                CornerRadius="11"
                                Cursor="Hand">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="NavigationGlyph"
                                           Grid.Column="0"
                                           Text="&#xE80F;"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe Fluent Icons"
                                           Foreground="{DynamicResource SidebarMutedTextBrush}"
                                           FontSize="16" />
                                <ContentPresenter x:Name="NavigationLabel"
                                                  Grid.Column="1"
                                                  Margin="0,0,12,0"
                                                  VerticalAlignment="Center"
                                                  TextElement.Foreground="{DynamicResource SidebarMutedTextBrush}"
                                                  ContentSource="Header" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavigationChrome" Property="Background" Value="{DynamicResource SidebarSelectionBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavigationChrome" Property="Background" Value="{DynamicResource SidebarSelectionBrush}" />
                                <Setter TargetName="NavigationGlyph" Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
                                <Setter TargetName="NavigationLabel" Property="TextElement.Foreground" Value="{DynamicResource SidebarTextBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="KeyboardHeatmap"><Setter TargetName="NavigationGlyph" Property="Text" Value="&#xE765;" /></Trigger>
                            <Trigger Property="Tag" Value="MouseButtons"><Setter TargetName="NavigationGlyph" Property="Text" Value="&#xE962;" /></Trigger>
                            <Trigger Property="Tag" Value="DataTools"><Setter TargetName="NavigationGlyph" Property="Text" Value="&#xE74E;" /></Trigger>
                            <Trigger Property="Tag" Value="Settings"><Setter TargetName="NavigationGlyph" Property="Text" Value="&#xE713;" /></Trigger>
                            <Trigger Property="Tag" Value="Privacy"><Setter TargetName="NavigationGlyph" Property="Text" Value="&#xE72E;" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="NavigationChrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavigationTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource NavigationTabItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="196" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Padding="12"
                                    Background="{DynamicResource SidebarBackgroundBrush}"
                                    BorderThickness="0"
                                    CornerRadius="18"
                                    Effect="{StaticResource CardShadowEffect}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Margin="10,6,0,0"
                                               Text="浏览"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource SidebarMutedTextBrush}" />
                                    <TabPanel Grid.Row="2" IsItemsHost="True" />
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Background="Transparent">
                                <AdornerDecorator>
                                    <ContentPresenter ContentSource="SelectedContent" TextElement.Foreground="{DynamicResource PrimaryTextBrush}" />
                                </AdornerDecorator>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="KeyboardKeyTemplate">
            <Border Width="{Binding Width}" Height="{Binding Height}"
                    Padding="4" CornerRadius="7"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    ToolTip="{Binding AccessibleLabel}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource HeatmapLevel0Brush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HeatLevel}" Value="1"><Setter Property="Background" Value="{DynamicResource HeatmapLevel1Brush}" /></DataTrigger>
                            <DataTrigger Binding="{Binding HeatLevel}" Value="2"><Setter Property="Background" Value="{DynamicResource HeatmapLevel2Brush}" /></DataTrigger>
                            <DataTrigger Binding="{Binding HeatLevel}" Value="3"><Setter Property="Background" Value="{DynamicResource HeatmapLevel3Brush}" /></DataTrigger>
                            <DataTrigger Binding="{Binding HeatLevel}" Value="4"><Setter Property="Background" Value="{DynamicResource HeatmapLevel4Brush}" /></DataTrigger>
                            <DataTrigger Binding="{Binding HeatLevel}" Value="5"><Setter Property="Background" Value="{DynamicResource HeatmapLevel5Brush}" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource HeatmapLevel0TextBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HeatLevel}" Value="1"><Setter Property="Foreground" Value="{DynamicResource HeatmapLevel1TextBrush}" /></DataTrigger>
                            <DataTrigger Binding="{Binding HeatLevel}" Value="2"><Setter Property="Foreground" Value="{DynamicResource HeatmapLevel2TextBrush}" /></DataTrigger>
                            <DataTrigger Binding="{Binding HeatLevel}" Value="3"><Setter Property="Foreground" Value="{DynamicResource HeatmapLevel3TextBrush}" /></DataTrigger>
                            <DataTrigger Binding="{Binding HeatLevel}" Value="4"><Setter Property="Foreground" Value="{DynamicResource HeatmapLevel4TextBrush}" /></DataTrigger>
                            <DataTrigger Binding="{Binding HeatLevel}" Value="5"><Setter Property="Foreground" Value="{DynamicResource HeatmapLevel5TextBrush}" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Resources>
                <Grid>
                    <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Top" />
                    <TextBlock Text="{Binding CountText}" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border Width="42" Height="42"
                        Background="{DynamicResource AccentBrush}"
                        CornerRadius="12"
                        Effect="{StaticResource CardShadowEffect}">
                    <TextBlock Text="IT"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="{DynamicResource AppTextFontFamily}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentTextBrush}" />
                </Border>
                <StackPanel Margin="12,0,0,0">
                    <TextBlock Text="InputTracker"
                               FontFamily="{DynamicResource AppTextFontFamily}"
                               FontSize="21"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,3,0,0"
                               Text="只记使用次数，不记输入内容"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
            </StackPanel>
            <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                <Button Style="{StaticResource QuietButtonStyle}" Click="HideButton_Click" Content="隐藏" />
                <Button Style="{StaticResource QuietButtonStyle}" Click="ExitButton_Click" Content="退出" />
            </WrapPanel>
        </Grid>

        <Border x:Name="GlobalCollectionBar"
                Grid.Row="2"
                Padding="14,11"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Effect="{StaticResource CardShadowEffect}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="8" Height="8"
                        VerticalAlignment="Center"
                        Background="{DynamicResource AccentBrush}"
                        CornerRadius="4" />
                <StackPanel Grid.Column="2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="StatusLabel" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock x:Name="StatusExplanation"
                                   Margin="10,1,16,0"
                                   TextTrimming="CharacterEllipsis"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="DirectoryText"
                               Margin="0,4,16,0"
                               TextTrimming="CharacterEllipsis"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
                <WrapPanel Grid.Column="3" VerticalAlignment="Center">
                    <Button x:Name="PauseButton"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="PauseButton_Click"
                            Content="暂停采集" />
                    <Button x:Name="ResumeButton"
                            Click="ResumeButton_Click"
                            Content="恢复采集" />
                </WrapPanel>
            </Grid>
        </Border>

        <Grid x:Name="PageContentHost" Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CompactCardStyle}" Padding="14,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="查看范围" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <ComboBox x:Name="PeriodSelector" Grid.Column="2" Width="104"
                              SelectionChanged="QuerySelection_Changed">
                        <ComboBoxItem Content="日" Tag="Day" IsSelected="True" />
                        <ComboBoxItem Content="周" Tag="Week" />
                        <ComboBoxItem Content="月" Tag="Month" />
                        <ComboBoxItem Content="年" Tag="Year" />
                    </ComboBox>
                    <Button x:Name="RefreshDashboardButton"
                            Grid.Column="4"
                            Style="{StaticResource SoftButtonStyle}"
                            Margin="0"
                            Click="RefreshDashboardButton_Click"
                            Content="立即刷新" />
                    <TextBlock x:Name="DashboardRefreshStatusText"
                               Grid.Column="6"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="数据每 2 秒自动更新"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

            <TabControl x:Name="NavigationList"
                        Grid.Row="2"
                        TabStripPlacement="Left"
                        Style="{StaticResource NavigationTabControlStyle}">
                <TabItem Header="总览" Tag="Overview">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="2,2,6,16">
                            <TextBlock Style="{StaticResource PageTitleStyle}" Text="活动概览" />
                            <TextBlock Style="{StaticResource PageSubtitleStyle}"
                                       Text="键盘按了多少次、鼠标点了多少次，一眼就能看到。" />
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource CardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="48" Height="48" VerticalAlignment="Top"
                                                Background="{DynamicResource AccentSoftBrush}" CornerRadius="14">
                                            <TextBlock Text="&#xE765;" FontFamily="Segoe Fluent Icons" FontSize="20"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="键盘使用" />
                                            <TextBlock x:Name="OverviewKeyboardSummary"
                                                       Margin="0,9,0,0"
                                                       Text="还没有键盘记录"
                                                       FontSize="21"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,8,0,0"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       Text="打开热力图，就能看出哪些按键最常用。"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="48" Height="48" VerticalAlignment="Top"
                                                Background="{DynamicResource AccentSoftBrush}" CornerRadius="14">
                                            <TextBlock Text="&#xE962;" FontFamily="Segoe Fluent Icons" FontSize="20"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="鼠标使用" />
                                            <TextBlock x:Name="OverviewMouseSummary"
                                                       Margin="0,9,0,0"
                                                       Text="还没有选择鼠标"
                                                       FontSize="21"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,8,0,0"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       Text="选一只鼠标，看看左键、右键和侧键各用了多少次。"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                            <Border Margin="0,16,0,0"
                                    Style="{StaticResource CompactCardStyle}"
                                    Background="{DynamicResource SubtleBackgroundBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32"
                                            Background="{DynamicResource AccentSoftBrush}"
                                            CornerRadius="16">
                                        <TextBlock Text="✓" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="只统计次数，不查看内容" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Text="InputTracker 只记下按了多少次、按住多久，不会保存你输入的文字。"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="键盘热力图" Tag="KeyboardHeatmap">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="2,2,6,16">
                            <TextBlock Style="{StaticResource PageTitleStyle}" Text="键盘热力图" />
                            <TextBlock Style="{StaticResource PageSubtitleStyle}"
                                       Text="颜色越深，说明这个按键用得越多。不会保存你输入的文字，也不会记下按键顺序。" />
                            <Border Margin="0,16,0,0" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="当前键盘" />
                                            <TextBlock x:Name="KeyboardSummary" Margin="0,8,16,0"
                                                       Text="还没有键盘记录" FontSize="16" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Width="360">
                                            <ComboBox x:Name="KeyboardDeviceSelector"
                                                      DisplayMemberPath="DisplayName" SelectedValuePath="DeviceId"
                                                      SelectionChanged="QuerySelection_Changed" />
                                            <TextBlock Margin="0,10,0,5" Text="给这把键盘起个容易认的名字" FontSize="12"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="KeyboardAliasInput" MaxLength="128" />
                                                <Button x:Name="SaveKeyboardAliasButton" Grid.Column="1" MinWidth="72"
                                                        Margin="8,0,0,0" Content="保存" IsEnabled="False"
                                                        Click="SaveKeyboardAliasButton_Click" />
                                                <Button x:Name="ClearKeyboardAliasButton" Grid.Column="2" MinWidth="72"
                                                        Margin="8,0,0,0" Content="清除" IsEnabled="False"
                                                        Click="ClearKeyboardAliasButton_Click" />
                                            </Grid>
                                            <TextBlock x:Name="KeyboardAliasStatusText" Margin="0,6,0,0"
                                                       Text="改名只方便你辨认，已有记录不会变化。" FontSize="12"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" Text="低" FontSize="12"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <WrapPanel Grid.Column="1" Margin="8,0,0,0">
                                            <Border Width="30" Height="10" Margin="0,0,3,0" Background="{DynamicResource HeatmapLevel0Brush}" CornerRadius="3" />
                                            <Border Width="30" Height="10" Margin="0,0,3,0" Background="{DynamicResource HeatmapLevel1Brush}" CornerRadius="3" />
                                            <Border Width="30" Height="10" Margin="0,0,3,0" Background="{DynamicResource HeatmapLevel2Brush}" CornerRadius="3" />
                                            <Border Width="30" Height="10" Margin="0,0,3,0" Background="{DynamicResource HeatmapLevel3Brush}" CornerRadius="3" />
                                            <Border Width="30" Height="10" Margin="0,0,3,0" Background="{DynamicResource HeatmapLevel4Brush}" CornerRadius="3" />
                                            <Border Width="30" Height="10" Margin="0,0,8,0" Background="{DynamicResource HeatmapLevel5Brush}" CornerRadius="3" />
                                            <TextBlock Margin="0,-3,0,0" Text="高" FontSize="12"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                        </WrapPanel>
                                    </Grid>
                                    <Border Margin="0,14,0,0"
                                            Padding="14"
                                            Background="{DynamicResource SubtleBackgroundBrush}"
                                            CornerRadius="12">
                                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                            <ItemsControl x:Name="HeatmapItems"
                                                          Width="1180" Height="340"
                                                          ItemTemplate="{StaticResource KeyboardKeyTemplate}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                            </ItemsControl>
                                        </Viewbox>
                                    </Border>
                                    <TextBlock Margin="0,14,0,0" Text="其他按键" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,4,0,10"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Text="没有常用名称的按键会显示在这里，次数照常保留。" />
                                    <ItemsControl x:Name="OtherHeatmapItems" ItemTemplate="{StaticResource KeyboardKeyTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="鼠标按键" Tag="MouseButtons">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="2,2,6,16">
                            <TextBlock Style="{StaticResource PageTitleStyle}" Text="鼠标按键" />
                            <TextBlock Style="{StaticResource PageSubtitleStyle}"
                                       Text="看看这段时间里，每只鼠标分别点击了多少次。" />
                            <Border Margin="0,16,0,0" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="当前鼠标" />
                                            <TextBlock x:Name="MouseSummary" Margin="0,8,16,0"
                                                       Text="选择鼠标后显示按键次数"
                                                       FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Width="360">
                                            <ComboBox x:Name="MouseDeviceSelector"
                                                      DisplayMemberPath="DisplayName" SelectedValuePath="DeviceId"
                                                      SelectionChanged="QuerySelection_Changed" />
                                            <TextBlock Margin="0,10,0,5" Text="给这只鼠标起个容易认的名字" FontSize="12"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="MouseAliasInput" MaxLength="128" />
                                                <Button x:Name="SaveMouseAliasButton" Grid.Column="1" MinWidth="72"
                                                        Margin="8,0,0,0" Content="保存" IsEnabled="False"
                                                        Click="SaveMouseAliasButton_Click" />
                                                <Button x:Name="ClearMouseAliasButton" Grid.Column="2" MinWidth="72"
                                                        Margin="8,0,0,0" Content="清除" IsEnabled="False"
                                                        Click="ClearMouseAliasButton_Click" />
                                            </Grid>
                                            <TextBlock x:Name="MouseAliasStatusText" Margin="0,6,0,0"
                                                       Text="改名只方便你辨认，已有记录不会变化。" FontSize="12"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Margin="0,16,0,0"
                                            Padding="14,12"
                                            Background="{DynamicResource SubtleBackgroundBrush}"
                                            CornerRadius="12">
                                        <TextBlock Text="这里只记录各个按键用了多少次，不会保存鼠标移动位置。"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="数据工具" Tag="DataTools">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="2,2,6,16">
                            <TextBlock Style="{StaticResource PageTitleStyle}" Text="数据工具" />
                            <TextBlock Style="{StaticResource PageSubtitleStyle}"
                                       Text="需要带走、备份或整理记录时，可以在这里操作。所有文件都留在当前程序文件夹。" />
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="导出与备份" />
                                        <TextBlock Margin="0,8,0,0" Text="保存一份可以带走的数据副本" FontSize="17" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,6,0,16"
                                                   Text="可以导出当前键盘统计，也可以备份全部本地数据。"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap" />
                                        <Button x:Name="ExportKeyboardButton" Style="{StaticResource PrimaryButtonStyle}"
                                                HorizontalAlignment="Left" Click="ExportKeyboardButton_Click"
                                                Content="导出 CSV + PNG" />
                                        <Button x:Name="CreateBackupButton" HorizontalAlignment="Left"
                                                Click="CreateBackupButton_Click" Content="创建完整备份" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="删除与恢复" />
                                        <TextBlock Margin="0,8,0,0" Text="动手前先看清会改动哪些记录" FontSize="17" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,6,0,16"
                                                   Text="删除前只能查看范围，不会直接动数据。恢复备份时，程序会先暂停记录并请你确认，完成后自动退出。"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap" />
                                        <Button x:Name="PreviewKeyboardDeletionButton" HorizontalAlignment="Left"
                                                Click="PreviewKeyboardDeletionButton_Click" Content="查看可删除记录" />
                                        <Button x:Name="ValidateRestoreButton" HorizontalAlignment="Left"
                                                Click="ValidateRestoreButton_Click" Content="恢复本地备份" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Margin="0,16,0,0"
                                    Style="{StaticResource CompactCardStyle}"
                                    Background="{DynamicResource SubtleBackgroundBrush}">
                                <StackPanel>
                                    <TextBlock Text="操作状态" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock x:Name="DataToolsStatusText" Margin="0,5,0,0"
                                               Text="尚未执行数据操作。" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="设置" Tag="Settings">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="2,2,6,16">
                            <TextBlock Style="{StaticResource PageTitleStyle}" Text="设置" />
                            <TextBlock Style="{StaticResource PageSubtitleStyle}"
                                       Text="在这里调整外观和是否随 Windows 启动。" />
                            <Border Margin="0,16,0,0" Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="外观" />
                                        <TextBlock Margin="0,8,0,0" Text="界面主题" FontSize="17" FontWeight="SemiBold" />
                                        <TextBlock x:Name="ThemeStatusText" Margin="0,5,0,0"
                                                   Text="当前为浅色主题。"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Button Style="{StaticResource SoftButtonStyle}" Click="LightThemeButton_Click" Content="浅色" />
                                        <Button Click="DarkThemeButton_Click" Content="深色" />
                                    </WrapPanel>
                                </Grid>
                            </Border>
                            <Border Margin="0,16,0,0" Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="Windows 启动" />
                                        <TextBlock Margin="0,8,0,0" Text="随 Windows 启动" FontSize="17" FontWeight="SemiBold" />
                                        <TextBlock x:Name="StartupStatusText" Margin="0,5,24,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Button Style="{StaticResource PrimaryButtonStyle}" Click="EnableStartupButton_Click" Content="启用开机启动" />
                                        <Button Click="DisableStartupButton_Click" Content="关闭开机启动" />
                                    </WrapPanel>
                                </Grid>
                            </Border>
                            <TextBlock Margin="4,16,4,0"
                                       Text="所有数据都在上方显示的程序文件夹里。卸载前先退出并关闭开机启动；需要保留记录时，先备份整个文件夹，再删除程序即可。"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="隐私" Tag="Privacy">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="2,2,6,16">
                            <TextBlock Style="{StaticResource PageTitleStyle}" Text="隐私与控制" />
                            <TextBlock Style="{StaticResource PageSubtitleStyle}"
                                       Text="你可以随时查看状态、暂停记录或退出程序。" />
                            <Border Margin="0,16,0,0" Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="48" Height="48" VerticalAlignment="Top"
                                            Background="{DynamicResource AccentSoftBrush}" CornerRadius="14">
                                        <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons" FontSize="20"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="现在会记录什么" />
                                        <TextBlock x:Name="PrivacyExplanation"
                                                   Margin="0,8,0,0"
                                                   FontSize="14"
                                                   LineHeight="22"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource CompactCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="键盘" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Text="分别记录每把键盘的按键次数和按住时长，不保存你输入的文字。"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource CompactCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="鼠标" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Text="分别记录每只鼠标的按键次数，不保存移动位置或路线。"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
