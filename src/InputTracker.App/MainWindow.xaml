<Window x:Class="InputTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="InputTracker"
        Width="960" Height="640" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Foreground="{StaticResource TextBrush}"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="InputTracker" FontSize="32" FontWeight="SemiBold" />
            <TextBlock Margin="0,8,0,0" Text="本地输入统计 · 采集边界始终可见" FontSize="15" Foreground="{StaticResource MutedTextBrush}" />
        </StackPanel>

        <Border Grid.Row="2" Padding="24" CornerRadius="12" Background="{StaticResource CardBrush}" BorderBrush="#1A172033" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="StatusLabel" FontSize="24" FontWeight="SemiBold" />
                <TextBlock x:Name="StatusExplanation" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="15" Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock x:Name="DirectoryText" Margin="0,16,0,0" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13" />
                <StackPanel Margin="0,24,0,0" Orientation="Horizontal">
                    <Button x:Name="PauseButton" Click="PauseButton_Click" Content="暂停" />
                    <Button x:Name="ResumeButton" Click="ResumeButton_Click" Content="恢复" />
                    <Button Click="HideButton_Click" Content="隐藏到托盘" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Padding="24" CornerRadius="12" Background="#FFF1F5F9">
            <StackPanel>
                <TextBlock Text="隐私边界" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="PrivacyExplanation" Margin="0,12,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Padding="20" CornerRadius="12" Background="{StaticResource CardBrush}" BorderBrush="#1A172033" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="真实统计" FontSize="18" FontWeight="SemiBold" />
                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <ComboBox x:Name="PeriodSelector" Width="120" SelectionChanged="QuerySelection_Changed">
                            <ComboBoxItem Content="日" Tag="Day" IsSelected="True" />
                            <ComboBoxItem Content="周" Tag="Week" />
                            <ComboBoxItem Content="月" Tag="Month" />
                            <ComboBoxItem Content="年" Tag="Year" />
                        </ComboBox>
                        <ComboBox x:Name="KeyboardDeviceSelector" Width="220" Margin="8,0,0,0" DisplayMemberPath="DisplayName" SelectedValuePath="DeviceId" SelectionChanged="QuerySelection_Changed" />
                    </StackPanel>
                    <TextBlock x:Name="KeyboardSummary" Margin="0,12,0,0" Text="尚无键盘聚合" TextWrapping="Wrap" />
                    <ItemsControl x:Name="HeatmapItems" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,8,8" Padding="8" MinWidth="72" Background="#FFE2E8F0" CornerRadius="6">
                                    <TextBlock Text="{Binding}" Foreground="#FF172033" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Padding="20" CornerRadius="12" Background="{StaticResource CardBrush}" BorderBrush="#1A172033" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="逐设备鼠标轨迹" FontSize="18" FontWeight="SemiBold" />
                    <ComboBox x:Name="MouseDeviceSelector" Width="220" Margin="0,12,0,0" HorizontalAlignment="Left" DisplayMemberPath="DisplayName" SelectedValuePath="DeviceId" SelectionChanged="QuerySelection_Changed" />
                    <TextBlock x:Name="MouseSummary" Margin="0,12,0,0" Text="选择鼠标后读取完整原始轨迹" TextWrapping="Wrap" />
                    <Canvas x:Name="MouseCanvas" Height="128" Margin="0,12,0,0" Background="#FFF8FAFC" ClipToBounds="True" />
                    <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Text="绘制副本按时间合并为最多 2048 个显示点；Storage 原始点读取不抽样。" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="8" Padding="20" CornerRadius="12" Background="{StaticResource CardBrush}" BorderBrush="#1A172033" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="绿色版与开机启动" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="StartupStatusText" Margin="0,12,0,0" TextWrapping="Wrap" />
                <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                    <Button Click="EnableStartupButton_Click" Content="启用开机启动" />
                    <Button Click="DisableStartupButton_Click" Content="关闭开机启动" />
                </StackPanel>
                <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"
                           Text="数据、配置、日志和备份均位于上方显示的程序目录。卸载前先退出 InputTracker 并关闭开机启动；需要保留数据时先备份整个程序目录，然后删除该绿色目录即可。不要在程序运行时移动或删除数据文件。" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Click="ExitButton_Click" Content="退出" />
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Window>
