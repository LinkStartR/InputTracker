<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\InputTracker.ico</ApplicationIcon>
    <AssemblyName>InputTracker</AssemblyName>
    <RootNamespace>InputTracker</RootNamespace>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="Switch.System.Windows.DoNotScaleForDpiChanges" Value="false" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\InputTracker.ico" />
    <Resource Include="Assets\InputTracker.png" />
    <ProjectReference Include="..\InputTracker.Input\InputTracker.Input.csproj" />
    <ProjectReference Include="..\InputTracker.Storage\InputTracker.Storage.csproj" />
  </ItemGroup>
</Project>
